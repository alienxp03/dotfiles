#!/bin/sh
# rex-zpick — sesh-style zoxide picker for Rex.
# Shows an fzf list of zoxide directories in a floating layer.
#   enter          open with the default target (usually: session)
#   ctrl-o         second stage: choose session / tab / pane / pane below
#
# Called by the zpick.lua config action as:  rex-zpick CTXFILE
# or in direct mode:                        rex-zpick --direct TARGET DIR CTXFILE
set -u

DIRECT=0
TARGET=$1
if [ "$TARGET" = "--direct" ]; then
  DIRECT=1
  TARGET=$2
  DIRECT_DIR=$3
  shift 3
fi
CTX=$1
shift

# --- read context written by the Lua action (KEY=VALUE lines) ---
SESSION=""
BLOCK=""
CLIENT=""
ENTER=""
CHOOSER=""
TARGETS=""
HEADER=""
FZFOPTS=""
MAX=""
while IFS='=' read -r k v || [ -n "$k" ]; do
  case "$k" in
    SESSION) SESSION=$v ;;
    BLOCK)   BLOCK=$v ;;
    CLIENT)  CLIENT=$v ;;
    ENTER)   ENTER=$v ;;
    CHOOSER) CHOOSER=$v ;;
    TARGETS) TARGETS=$v ;;
    HEADER)  HEADER=$v ;;
    FZFOPTS) FZFOPTS=$v ;;
    MAX)     MAX=$v ;;
  esac
done < "$CTX"
rm -f "$CTX"

# mise shims cover fzf/zoxide when the login PATH doesn't
export PATH="$HOME/.local/share/mise/shims:$PATH"

# the rex CLI isn't always on the server's PATH; find it
if ! command -v rex >/dev/null 2>&1; then
  for c in \
    "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS" \
    /usr/local/bin /opt/homebrew/bin; do
    if [ -x "$c/rex" ]; then PATH="$c:$PATH"; break; fi
  done
fi

# "last session" state, shared with the zpick_last action
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/rex/zpick-last"

if [ "$DIRECT" = "1" ]; then
  DIR=$DIRECT_DIR
  ACTION=$TARGET
else
  # --- list + picker ---
  if [ -n "$MAX" ] && [ "$MAX" != 0 ]; then
    LIST="zoxide query -l | head -n $MAX"
  else
    LIST="zoxide query -l"
  fi

  set -- fzf \
    --ansi --delimiter='\t' \
    --expect="enter,$CHOOSER" \
    --header="$HEADER" \
    --height=100% --layout=reverse --border --info=hidden
  # shellcheck disable=SC2086
  [ -n "$FZFOPTS" ] && set -- "$@" $FZFOPTS

  # rows: bold basename <tab> dim path (with ~); search hits the whole line
  OUT=$(eval "$LIST" | awk -v h="$HOME" '{
    p = $0
    n = p; sub(/.*\//, "", n)
    t = p; sub("^" h, "~", t)
    printf "\033[1m%s\033[0m\t\033[2m%s\033[0m\n", n, t
  }' | "$@")
  KEY=$(printf '%s\n' "$OUT" | sed -n 1p)
  RAW=$(printf '%s\n' "$OUT" | sed -n 2p)

  # escape / empty pick: just close
  [ -z "$RAW" ] && exit 0
  DIR=$(printf '%s\n' "$RAW" | sed 's/\x1b\[[0-9;]*m//g' | cut -f2)
  case $DIR in \~*) DIR=$HOME${DIR#\~} ;; esac
  [ -d "$DIR" ] || exit 0

  if [ "$KEY" = "$CHOOSER" ] && [ -n "$CHOOSER" ]; then
    # --- stage 2: choose the target ---
    ITEM_LIST=""
    SAVEIFS=$IFS
    IFS=,
    for t in $TARGETS; do
      case "$t" in
        "") continue ;;
        session)    lbl="session" ;;
        tab)        lbl="tab" ;;
        pane)       lbl="pane →" ;;
        pane_below) lbl="pane ↓" ;;
        here)       lbl="cd here" ;;
        *)          lbl=$t ;;
      esac
      ITEM_LIST="$ITEM_LIST$lbl\n"
    done
    IFS=$SAVEIFS

    set -- fzf \
      --header="open as:" \
      --height=100% --layout=reverse --border --info=hidden
    # shellcheck disable=SC2086
    [ -n "$FZFOPTS" ] && set -- "$@" $FZFOPTS

    OUT=$(printf '%b' "$ITEM_LIST" | "$@")
    ACTION=$(printf '%s\n' "$OUT" | sed -n 1p)
    case "$ACTION" in
      "pane →") ACTION=pane ;;
      "pane ↓") ACTION=pane_below ;;
      "cd here") ACTION=here ;;
    esac
    [ -z "$ACTION" ] && exit 0
  else
    ACTION=$ENTER
  fi
fi

NAME=${DIR##*/}

case "$ACTION" in
  session)
    # reuse a session with the same label, else create one
    SID=$(rex ls --json 2>/dev/null | python3 -c '
import json, sys
name = sys.argv[1]
for s in json.load(sys.stdin).get("sessions", []):
    if s.get("label") == name:
        print(s["session_id"]); break
' "$NAME" 2>/dev/null)
    if [ -z "$SID" ]; then
      SID=$(rex new --json -c "$DIR" "$NAME" 2>/dev/null | python3 -c '
import json, sys
print(json.load(sys.stdin).get("session_id", ""))
' 2>/dev/null)
    fi
    [ -z "$SID" ] && exit 1
    # remember where we came from, for zpick_last
    if [ -n "$SESSION" ] && [ "$SESSION" != "$SID" ]; then
      mkdir -p "$(dirname "$STATE")"
      printf '%s\n' "$SESSION" > "$STATE"
    fi
    if [ -n "$CLIENT" ]; then
      rex -C "$CLIENT" do session.select session_id="$SID" >/dev/null 2>&1
    fi
    ;;
  here)
    if [ -n "$BLOCK" ]; then
      # only type cd when the target pane is at a shell prompt, not inside an app
      FG=$(rex do -e "local r = rex.block.call('com.superlogical.terminal', 'process', { block_id = '$BLOCK' }) print(r and r.foreground and r.foreground.name or '')" 2>/dev/null | tail -n 1)
      case "$FG" in
        zsh|bash|sh|dash|ksh|fish|nu|elvish)
          rex send -b "$BLOCK" "cd '$DIR'
"
          ;;
      esac
    fi
    ;;
  tab)
    if [ -n "$SESSION" ]; then
      WID=$(rex window new -s "$SESSION" "$NAME" -c "$DIR" --json 2>/dev/null | python3 -c '
import json, sys
print(json.load(sys.stdin).get("window_id", ""))
' 2>/dev/null)
      if [ -n "$WID" ]; then
        if [ -n "$CLIENT" ]; then
          rex -C "$CLIENT" do session.select session_id="$SESSION" window_id="$WID" >/dev/null 2>&1
        else
          rex focus -s "$SESSION" "$WID" >/dev/null 2>&1
        fi
      fi
    fi
    ;;
  pane)
    if [ -n "$BLOCK" ]; then
      BID=$(rex split -s "$SESSION" -b "$BLOCK" --split=right -c "$DIR" --json 2>/dev/null | python3 -c '
import json, sys
ids = json.load(sys.stdin).get("block_ids", [])
print(ids[0] if ids else "")
' 2>/dev/null)
      [ -n "$BID" ] && rex focus -s "$SESSION" -b "$BID" >/dev/null 2>&1
    fi
    ;;
  pane_below)
    if [ -n "$BLOCK" ]; then
      BID=$(rex split -s "$SESSION" -b "$BLOCK" --split=below -c "$DIR" --json 2>/dev/null | python3 -c '
import json, sys
ids = json.load(sys.stdin).get("block_ids", [])
print(ids[0] if ids else "")
' 2>/dev/null)
      [ -n "$BID" ] && rex focus -s "$SESSION" -b "$BID" >/dev/null 2>&1
    fi
    ;;
esac
exit 0
