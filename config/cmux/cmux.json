{
  "$schema" : "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion" : 1,
  "app" : {
    "minimalMode" : false,
    "tabBarVisibility" : "multiple-tabs",
    "reorderOnNotification" : false
  },
  "integrations" : {
    "claudeCode" : {
      "hooksEnabled" : false
    }
  },
  "automation" : {
    "workspaceAutoNaming" : false
  },
  "notifications" : {
    "sound" : "none",
    "agentPermissionPrompt" : true,
    "agentTurnComplete" : "never",
    "agentIdleReminder" : true
  },
  "shortcuts" : {
    "bindings" : {
      "clearScreenKeepScrollback" : "cmd+k",
      "toggleSplitZoom" : "cmd+shift+f",
      "findInDirectory" : null,
      "nextSidebarTab" : "cmd+shift+]",
      "prevSidebarTab" : "cmd+shift+[",
      "nextSurface" : null,
      "prevSurface" : null,
      "focusDown" : "ctrl+j",
      "focusLeft" : "ctrl+h",
      "focusRight" : "ctrl+l",
      "focusUp" : "ctrl+k"
    }
  },
  "sidebar" : {
    "showBranchDirectory" : false,
    "showLog" : false,
    "showNotificationMessage" : false
  },
  "browser" : {
    "openTerminalLinksInCmuxBrowser" : false
  }
}